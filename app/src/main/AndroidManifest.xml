<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <!-- 1. HARDWARE SENSOR PERMISSION -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- 2. FOREGROUND SERVICE PERMISSIONS -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 3. NOTIFICATION PERMISSION -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 4. HARDWARE REQUIREMENT -->
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="true" />
    <application
        android:name=".StepCounterApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_walking"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_walking"
        android:supportsRtl="true"
        android:theme="@style/Theme.StepCounter"
        tools:targetApi="33"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.StepCounter" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.StepTrackingService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>